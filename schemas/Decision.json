{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "rlflow/0.2",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "producer": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "input_versions": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "entries"
      ]
    },
    "decision": {
      "enum": [
        "CONTINUE",
        "ENGINEERING_DIAGNOSIS",
        "PARAMETER_SEARCH",
        "METHOD_REVIEW",
        "EVALUATION_REVIEW",
        "STOP"
      ],
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "prediction": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "producer",
    "created_at",
    "input_versions",
    "decision",
    "evidence_refs",
    "counterevidence",
    "next_action",
    "prediction"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
