{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:rlflow:standalone:schema:ToolLedger",
 "$defs":{
  "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"count":{"type":"integer","minimum":0,"maximum":9223372036854775807},
  "context":{"type":"object","properties":{"schema_version":{"const":"1.0"},"session":{"type":"string","minLength":1,"maxLength":160},"generation":{"type":"string","minLength":1,"maxLength":160},"request_sha256":{"$ref":"#/$defs/hash"},"candidate_sha256":{"$ref":"#/$defs/hash"}},"required":["schema_version","session","generation","request_sha256","candidate_sha256"],"additionalProperties":false},
  "cursor":{"type":"object","properties":{"epoch":{"$ref":"#/$defs/hash"},"device":{"$ref":"#/$defs/count"},"inode":{"$ref":"#/$defs/count"},"offset":{"$ref":"#/$defs/count"},"ordinal":{"$ref":"#/$defs/count"},"record_sha256":{"$ref":"#/$defs/hash"}},"required":["epoch","device","inode","offset","ordinal","record_sha256"],"additionalProperties":false},
  "witness":{"type":"object","properties":{"release_sha256":{"$ref":"#/$defs/hash"},"model_release_sha256":{"$ref":"#/$defs/hash"},"ack_sha256":{"$ref":"#/$defs/hash"}},"required":["release_sha256","model_release_sha256","ack_sha256"],"additionalProperties":false},
  "registration":{"type":"object","properties":{"schema_version":{"const":"1.0"},"kind":{"const":"CPU_REGISTER"},"epoch":{"$ref":"#/$defs/hash"},"ordinal":{"type":"integer","minimum":1},"previous_sha256":{"$ref":"#/$defs/hash"},"command_digest":{"$ref":"#/$defs/hash"},"intent_sha256":{"$ref":"#/$defs/hash"},"context":{"$ref":"#/$defs/context"},"launch_witness":{"anyOf":[{"$ref":"#/$defs/witness"},{"type":"null"}]},"record_sha256":{"$ref":"#/$defs/hash"}},"required":["schema_version","kind","epoch","ordinal","previous_sha256","command_digest","intent_sha256","context","launch_witness","record_sha256"],"additionalProperties":false},
  "fact":{"type":"object","properties":{"schema_version":{"const":"1.0"},"kind":{"const":"CPU_EXEC_RETURN"},"tool":{"const":"cpu_exec"},"context":{"$ref":"#/$defs/context"},"intent_sha256":{"$ref":"#/$defs/hash"},"result_sha256":{"$ref":"#/$defs/hash"},"state":{"enum":["RETURNED","TIMED_OUT","SETUP_FAILED"]},"exit_code":{"type":"integer","minimum":-2147483648,"maximum":2147483647},"timed_out":{"type":"boolean"},"wall_seconds":{"type":"number","minimum":0},"infrastructure_error":{"enum":[null,"CPU_SANDBOX_SETUP_FAILED"]}},"required":["schema_version","kind","tool","context","intent_sha256","result_sha256","state","exit_code","timed_out","wall_seconds","infrastructure_error"],"additionalProperties":false},
  "source":{"type":"object","properties":{"schema_version":{"const":"1.0"},"id":{"$ref":"#/$defs/hash"},"context":{"$ref":"#/$defs/context"},"revision":{"$ref":"#/$defs/count"},"cursor":{"anyOf":[{"$ref":"#/$defs/cursor"},{"type":"null"}]},"pending_after":{"type":"string","maxLength":129},"status":{"enum":["ACTIVE","DRAINED","QUARANTINED","UNSUPPORTED"]},"reason":{"enum":[null,"SOURCE_INVALID","SOURCE_MISSING","SOURCE_CAPACITY","DISK_RAW_UNSUPPORTED"]},"incomplete_tail":{"type":"boolean"}},"required":["schema_version","id","context","revision","cursor","pending_after","status","reason","incomplete_tail"],"additionalProperties":false},
  "receipt":{"type":"object","properties":{"schema_version":{"const":"1.0"},"id":{"type":"string","pattern":"^[0-9a-f]{64}:[0-9a-f]{64}$"},"source_id":{"$ref":"#/$defs/hash"},"registration":{"$ref":"#/$defs/registration"},"semantic_digest":{"$ref":"#/$defs/hash"},"status":{"enum":["PENDING","COLLECTED"]},"verification":{"enum":["PENDING","VERIFIED","UNVERIFIED"]},"reason":{"enum":[null,"REGISTER_UNVERIFIED","BINDING_INVALID"]},"task_id":{"type":"string"},"fact":{"anyOf":[{"$ref":"#/$defs/fact"},{"type":"null"}]},"validation_digest":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]}},"required":["schema_version","id","source_id","registration","semantic_digest","status","verification","reason","fact","validation_digest"],"additionalProperties":false},
  "scan":{"type":"object","properties":{"after":{"type":"string","maxLength":64},"round":{"$ref":"#/$defs/count"}},"required":["after","round"],"additionalProperties":false}
 }
}
