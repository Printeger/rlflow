{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "rlflow/0.2",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "producer": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "input_versions": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "entries"
      ]
    },
    "statement": {
      "type": "string"
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counter_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discriminating_test": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "SUPPORTED",
        "FALSIFIED",
        "INCONCLUSIVE",
        "SUPERSEDED"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "producer",
    "created_at",
    "input_versions",
    "statement",
    "supporting_evidence",
    "counter_evidence",
    "discriminating_test",
    "status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
