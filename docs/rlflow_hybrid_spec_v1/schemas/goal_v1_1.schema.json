{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rlflow:spec:goal-proposal:1.1",
  "title": "Unapproved goal proposal with explicit tool and evaluation boundaries",
  "description": "Still only a proposal. Registry hashes and references are declarations, not trusted approval or enforceability proofs. Missing 1.0 fields require a new contract revision, never implicit defaults.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "live",
        "fixture"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "goal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 16000
    },
    "goal_kind": {
      "type": "string",
      "enum": [
        "engineering",
        "research"
      ]
    },
    "global_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "verification": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "deterministic",
                  "independent_review",
                  "experiment"
                ]
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "evidence_required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "method",
              "rule",
              "evidence_required"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "description",
          "required",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "writable_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "allowed_command_templates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 0
        },
        "network_access": {
          "type": "string",
          "enum": [
            "none",
            "allowlist"
          ]
        },
        "allowed_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "writable_paths",
        "protected_paths",
        "allowed_command_templates",
        "network_access",
        "allowed_hosts"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "model_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "model_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_token_enforcement": {
          "type": "string",
          "enum": [
            "hard_required",
            "soft_approved"
          ]
        },
        "gpu_device_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "experiment_starts": {
          "type": "integer",
          "minimum": 0
        },
        "experiment_retries": {
          "type": "integer",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "finalization_reserve_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        }
      },
      "required": [
        "model_sessions",
        "model_input_tokens",
        "model_output_tokens",
        "model_token_enforcement",
        "gpu_device_seconds",
        "experiment_starts",
        "experiment_retries",
        "wall_seconds",
        "finalization_reserve_fraction"
      ],
      "additionalProperties": false
    },
    "stop_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "approval_status": {
      "const": "UNAPPROVED"
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "registry_bindings": {
      "type": "object",
      "properties": {
        "tool_registry_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "command_registry_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime_profile_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resource_profile_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dataset_registry_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "tool_registry_hash",
        "command_registry_hash",
        "runtime_profile_hash",
        "resource_profile_hash",
        "dataset_registry_hash"
      ],
      "additionalProperties": false
    },
    "evaluation_data": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "EXPLICIT_NONE",
            "REGISTERED_DATASETS"
          ]
        },
        "datasets": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "dataset_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "version_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "purpose": {
                "enum": [
                  "training",
                  "validation",
                  "evaluation",
                  "reference"
                ]
              },
              "access": {
                "enum": [
                  "READ_ONLY",
                  "PROTECTED_EVALUATOR_ONLY"
                ]
              }
            },
            "required": [
              "dataset_id",
              "version_hash",
              "purpose",
              "access"
            ],
            "additionalProperties": false
          }
        },
        "evaluation_rule": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "version_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "version_hash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mode",
        "datasets",
        "evaluation_rule"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "EXPLICIT_NONE"
              }
            }
          },
          "then": {
            "properties": {
              "datasets": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "datasets": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "data_mode",
    "project_id",
    "goal_id",
    "contract_version",
    "objective",
    "goal_kind",
    "global_conditions",
    "scope",
    "budget",
    "stop_rules",
    "risk",
    "approval_status",
    "allowed_tools",
    "registry_bindings",
    "evaluation_data"
  ],
  "additionalProperties": false
}
