{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rlflow:spec:command:1.0",
  "title": "rlflow command request",
  "description": "Principal comes from authenticated server context. Idempotency-Key is an HTTP header. Schema does not authorize an operation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "action": {
      "type": "string",
      "enum": [
        "submit_goal",
        "approve",
        "reject",
        "pause",
        "resume",
        "stop",
        "reconcile"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "project",
            "goal",
            "approval",
            "execution"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "parameters": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "action",
    "target",
    "parameters"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "submit_goal"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "goal": {
                "$ref": "urn:rlflow:spec:goal-proposal:1.0"
              }
            },
            "required": [
              "goal"
            ],
            "additionalProperties": false
          },
          "target": {
            "properties": {
              "kind": {
                "const": "project"
              }
            }
          }
        },
        "required": [
          "expected_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "approve"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "proposal_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "reason": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "proposal_hash"
            ],
            "additionalProperties": false
          },
          "target": {
            "properties": {
              "kind": {
                "const": "approval"
              }
            }
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reject"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "proposal_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "proposal_hash",
              "reason"
            ],
            "additionalProperties": false
          },
          "target": {
            "properties": {
              "kind": {
                "const": "approval"
              }
            }
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "pause"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "strategy": {
                "const": "drain"
              }
            },
            "required": [
              "reason",
              "strategy"
            ],
            "additionalProperties": false
          },
          "target": {
            "properties": {
              "kind": {
                "const": "goal"
              }
            }
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "resume"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          },
          "target": {
            "properties": {
              "kind": {
                "const": "goal"
              }
            }
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "stop"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "grace_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              }
            },
            "required": [
              "reason",
              "grace_seconds"
            ],
            "additionalProperties": false
          },
          "target": {
            "properties": {
              "kind": {
                "enum": [
                  "goal",
                  "project",
                  "execution"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reconcile"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          },
          "target": {
            "properties": {
              "kind": {
                "const": "execution"
              }
            }
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_version"
        ]
      }
    }
  ]
}
